{
  "name": "robot-api",
  "version": "1.0.0",
  "description": "Generic Service Robot Node.js/JavaScript API",
  "license": "MIT",
  "repository": "tue-robotics/robot-api",
  "author": "Ramon Wijnands <rayman747@hotmail.com> (https://github.com/Rayman)",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "xo --config xo.config.js",
    "clean": "rimraf dist/",
    "deps": "npm run deps:missing && npm run deps:extra",
    "deps:missing": "dependency-check . --missing",
    "deps:extra": "dependency-check . --extra --no-dev",
    "prebuild": "npm run clean && npm run lint",
    "build": "npm run build_cjs && npm run build_esm",
    "postbuild": "npm run deps",
    "build_cjs": "cross-env BABEL_ENV=cjs babel lib/ --out-dir dist/cjs/ --source-maps",
    "build_esm": "cross-env BABEL_ENV=esm babel lib/ --out-dir dist/esm/ --source-maps",
    "test": "mocha \"test/**/*.test.js\"",
    "coverage": "c8 mocha \"test/**/*.test.js\"",
    "version": "npm run build",
    "patch": "npm version patch",
    "minor": "npm version minor",
    "major": "npm version major",
    "postversion": "git push && git push --tags"
  },
  "files": [
    "dist/",
    "lib/"
  ],
  "keywords": [
    "robot",
    "robotics",
    "ros",
    "rosbridge",
    "roslib",
    "api"
  ],
  "dependencies": {
    "eventemitter2": "^6.4.5",
    "lodash": "^4.18.1",
    "query-string": "^9.5.0",
    "roslib": "^2.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.0",
    "@babel/core": "^8.0.0",
    "@babel/eslint-parser": "^8.0.0",
    "@babel/plugin-transform-class-properties": "^8.0.0",
    "@babel/plugin-transform-classes": "^8.0.0",
    "@babel/plugin-transform-private-methods": "^8.0.1",
    "@babel/preset-env": "^8.0.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "dependency-check": "^4.1.0",
    "globals": "^17.12.0",
    "mocha": "^12.0.1",
    "rimraf": "^6.1.2",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "xo": "^5.0.1"
  },
  "c8": {
    "all": true,
    "include": [
      "lib/**/*.js"
    ],
    "exclude": [
      "lib/graveyard/**"
    ],
    "reporter": [
      "text",
      "lcov"
    ]
  }
}
